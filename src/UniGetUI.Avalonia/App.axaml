<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UniGetUI.Avalonia.App"
            xmlns:classic="clr-namespace:Classic.Avalonia.Theme;assembly=Classic.Avalonia.Theme"
            xmlns:sys="using:System"
             xmlns:avaloniaApplication1="clr-namespace:UniGetUI.Avalonia"
             Name="UniGetUI"
             RequestedThemeVariant="Default">

    <!-- macOS: Avalonia injects a default app menu with an "About Avalonia" entry when the
         application declares none. Declaring an empty one suppresses it; the standard
         Services/Hide/Quit items are still appended by the native menu exporter. -->
    <NativeMenu.Menu>
        <NativeMenu />
    </NativeMenu.Menu>

    <Application.DataTemplates>
        <avaloniaApplication1:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <ClassicTheme />
        <Style Selector="Window">
            <Setter Property="Theme" Value="{StaticResource ClassicWindow}" />
        </Style>
        <classic:ClassicTheme FontAliasing="False" />
        <StyleInclude Source="avares://Classic.Avalonia.Theme.DataGrid/Classic.axaml"/>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
        <StyleInclude Source="avares://UniGetUI/Assets/Styles/Styles.Common.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <!-- Полный набор кистей-заглушек для предотвращения падений DataGrid -->
        <SolidColorBrush x:Key="SystemControlTransparentBrush" Color="Transparent" />
        <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#12000000" />
        <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="#33000000" />
        <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="Black" />
        <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#11000000" />
        <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="White" />
        <sys:Double x:Key="ControlContentThemeFontSize">12</sys:Double>
        <FontFamily x:Key="ControlContentThemeFontFamily">Consolas, Courier New, monospace</FontFamily>
    </Application.Resources>

</Application>
